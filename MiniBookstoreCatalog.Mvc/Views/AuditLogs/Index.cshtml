@model MiniBookstoreCatalog.Mvc.ViewModels.AuditLogFilterViewModel

<h2>Audit Logs</h2>

<p><b>Total logs:</b> @Model.Logs.Count</p>

<form method="get" class="row g-3 mb-3">

    <div class="col-md-3">
        <input asp-for="EntityName" class="form-control" placeholder="Entity Name" />
    </div>

    <div class="col-md-3">
        <select asp-for="Action" class="form-select">
            <option value="">-- All --</option>
            <option>Create</option>
            <option>Update</option>
            <option>Delete</option>
            <option>Restore</option>
        </select>
    </div>

    <div class="col-md-2">
        <input asp-for="FromDate" type="date" class="form-control" />
    </div>

    <div class="col-md-2">
        <input asp-for="ToDate" type="date" class="form-control" />
    </div>

    <div class="col-md-2">
        <button class="btn btn-primary w-100">Search</button>
    </div>

</form>

@if (Model.Logs.Count == 0)
{
    <div class="alert alert-warning">
        No audit logs found.
    </div>
}
else
{
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Time</th>
            <th>Entity</th>
            <th>EntityId</th>
            <th>Action</th>
            <th>User</th>
        </tr>
    </thead>

    <tbody>
    @foreach (var item in Model.Logs)
    {
        <tr>
            <td>@item.CreatedAt</td>
            <td>@item.EntityName</td>
            <td>@item.EntityId</td>
            <td>@item.Action</td>
            <td>@item.UserName</td>
        </tr>
    }
    </tbody>
</table>
}
