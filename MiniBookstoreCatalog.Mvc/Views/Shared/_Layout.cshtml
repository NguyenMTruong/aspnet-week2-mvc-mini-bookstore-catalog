<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MiniBookstoreCatalog.Mvc</title>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <header class="site-header">
        <div class="container header-content">
            <div class="brand">
                <a asp-controller="Home" asp-action="Index">MiniBookstoreCatalog.Mvc</a>
            </div>

            <nav class="main-nav">
                <a asp-controller="Home" asp-action="Index">Dashboard</a>
                <a asp-controller="Books" asp-action="Index">Books</a>
                <a asp-controller="Books" asp-action="Create">Create</a>
                <a asp-controller="Books" asp-action="Trash">Trash</a>
                <a asp-controller="AuditLogs" asp-action="Index">Audit Logs</a>
                <a href="/health/ready">Health</a>
                <a href="/api/books/9999">API Error Demo</a>
            </nav>
        </div>
    </header>

    <main class="container main-content">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">

                @TempData["Success"]

            </div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-content">
            <span>&copy; 2025 - MiniBookstoreCatalog.Mvc - Lab03</span>
            <a href="#">Privacy</a>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
