@model MiniBookstoreCatalog.Mvc.ViewModels.BookListItemViewModel

<div class="card mb-3">

    <div class="card-body">

        <h5>@Model.Title</h5>

        <p>
            Author:
            @Model.Author
        </p>

        <p>
            Price:
            @Model.Price.ToString("N0")
        </p>

        <a asp-controller="Books"
           asp-action="Detail"
           asp-route-id="@Model.Id"
           class="btn btn-primary">
            Detail
        </a>

    </div>

</div>

