@model MiniBookstoreCatalog.Mvc.ViewModels.OrderCreateViewModel

<h2>Create Order</h2>

<form asp-action="Create"
      method="post">

    <div class="mb-3">
        <label asp-for="BookId"></label>

        <input asp-for="BookId"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Quantity"></label>

        <input asp-for="Quantity"
               class="form-control" />
    </div>

    <button class="btn btn-success">
        Create Order
    </button>

</form>

