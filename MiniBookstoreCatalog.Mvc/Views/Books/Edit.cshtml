@model MiniBookstoreCatalog.Mvc.ViewModels.BookEditViewModel


@{
    ViewData["Title"] = "Edit Book";
}


<h2>Edit Book</h2>


<form asp-action="Edit"
      method="post">


    <input asp-for="Id"
           type="hidden" />


    <input asp-for="RowVersion"
           type="hidden" />




    <div class="mb-3">

        <label asp-for="BookCode"></label>

        <input asp-for="BookCode"
               class="form-control"/>

        <span asp-validation-for="BookCode"
              class="text-danger"></span>

    </div>





    <div class="mb-3">

        <label asp-for="ISBN"></label>

        <input asp-for="ISBN"
               class="form-control"/>

    </div>





    <div class="mb-3">

        <label asp-for="Title"></label>

        <input asp-for="Title"
               class="form-control"/>

    </div>




    <div class="mb-3">

        <label asp-for="Author"></label>

        <input asp-for="Author"
               class="form-control"/>

    </div>





    <div class="mb-3">

        <label asp-for="Price"></label>

        <input asp-for="Price"
               class="form-control"/>

    </div>




    <div class="mb-3">

        <label asp-for="Stock"></label>

        <input asp-for="Stock"
               class="form-control"/>

    </div>





    <div class="mb-3">

        <label asp-for="MinStock"></label>

        <input asp-for="MinStock"
               class="form-control"/>

    </div>





    <div class="mb-3">

        <label asp-for="CategoryId"></label>

        <input asp-for="CategoryId"
               class="form-control"/>

    </div>





    <button class="btn btn-primary">
        Save
    </button>


</form>