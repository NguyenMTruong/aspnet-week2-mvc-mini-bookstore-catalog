@model BookStatsViewModel

@{
    ViewData["Title"] = "Book Inventory Stats";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Book Inventory Stats</h2>

        <p class="page-description">
            Trang này giúp bạn xem nhanh tổng quan tình hình kho sách của cửa hàng.
        </p>
    </div>

    <a class="btn btn-light" href="/Books">
        Quay lại danh sách
    </a>
</div>

<div class="stat-grid">

    <div class="stat-card">
        <div class="stat-number">
            @Model.TotalBooks
        </div>

        <div class="stat-label">
            Tổng số đầu sách
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-number">
            @Model.TotalQuantity
        </div>

        <div class="stat-label">
            Tổng số lượng sách
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-number">
            @Model.TotalInventoryValueText
        </div>

        <div class="stat-label">
            Tổng giá trị kho sách
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-number text-danger">
            @Model.OutOfStockCount
        </div>

        <div class="stat-label">
            Sách đã hết hàng
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-number text-warning">
            @Model.NeedReorderCount
        </div>

        <div class="stat-label">
            Sách cần nhập thêm
        </div>
    </div>

</div>

<div class="info-panel">

    <h4>Đánh giá tình hình kho sách</h4>

    @if (Model.OutOfStockCount > 0)
    {
        <p class="text-danger">
            Có sách đã hết hàng. Cần nhập thêm sớm để tránh thiếu hàng.
        </p>
    }
    else if (Model.NeedReorderCount > 0)
    {
        <p class="text-warning">
            Một số sách sắp hết. Nên lập kế hoạch nhập thêm.
        </p>
    }
    else
    {
        <p class="text-success">
            Kho sách hiện tại đang ổn định.
        </p>
    }

</div>

<table class="table table-bordered mt-4">

    <tr>
        <th>Tổng số đầu sách</th>
        <td>@Model.TotalBooks</td>
    </tr>

    <tr>
        <th>Tổng số lượng sách</th>
        <td>@Model.TotalQuantity</td>
    </tr>

    <tr>
        <th>Tổng giá trị kho sách</th>
        <td>@Model.TotalInventoryValueText</td>
    </tr>

    <tr>
        <th>Số sách đã hết hàng</th>
        <td>@Model.OutOfStockCount</td>
    </tr>

    <tr>
        <th>Số sách cần nhập thêm</th>
        <td>@Model.NeedReorderCount</td>
    </tr>

</table>
