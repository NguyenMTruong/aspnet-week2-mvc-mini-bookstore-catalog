@{
    ViewData["Title"] = "Book Inventory Stats";
}

@model MiniBookstoreCatalog.Mvc.ViewModels.BookStatsViewModel

<h2>Inventory Statistics</h2>

<div class="row">

    <div class="col-md-3">
        <div class="card p-3">
            Total Books:
            @Model.TotalBooks
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3">
            Total Quantity:
            @Model.TotalQuantity
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3">
            Inventory Value:
            @Model.TotalInventoryValue.ToString("N0")
        </div>
    </div>

</div>

