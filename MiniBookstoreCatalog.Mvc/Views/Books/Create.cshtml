@model MiniBookstoreCatalog.Mvc.ViewModels.BookCreateViewModel

@{
    ViewData["Title"] = "Create Book";
}

<h2>Create Book</h2>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label asp-for="ISBN"></label>
        <input asp-for="ISBN"
               class="form-control" />
        <span asp-validation-for="ISBN"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Title"></label>
        <input asp-for="Title"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Author"></label>
        <input asp-for="Author"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Price"></label>
        <input asp-for="Price"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Stock"></label>
        <input asp-for="Stock"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="MinStock"></label>
        <input asp-for="MinStock"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="CategoryId"></label>
        <input asp-for="CategoryId"
               class="form-control" />
    </div>

    <button type="submit"
            class="btn btn-primary">
        Save
    </button>

</form>

