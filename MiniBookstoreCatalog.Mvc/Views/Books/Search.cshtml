
@model List<MiniBookstoreCatalog.Mvc.ViewModels.BookListItemViewModel>

@{
    ViewData["Title"] = "Search Books";
}

<h2>Search Books</h2>

<form method="get">

    <input name="keyword"
           class="form-control"
           placeholder="Keyword..." />

    <br />

    <button class="btn btn-primary">
        Search
    </button>

</form>

<hr />

<table class="table table-bordered">

@foreach(var item in Model)
{
    <tr>
        <td>@item.Title</td>
        <td>@item.Author</td>
        <td>@item.CategoryName</td>
    </tr>
}

</table>

