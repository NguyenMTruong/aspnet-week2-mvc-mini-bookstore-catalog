@model List<MiniBookstoreCatalog.Mvc.Models.Book>

<h2>Low Stock Books</h2>

<table class="table">
    <thead>
        <tr>
            <th>Book Code</th>
            <th>Title</th>
            <th>Stock</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var book in Model)
        {
            <tr>
                <td>@book.BookCode</td>
                <td>@book.Title</td>
                <td>@book.Stock</td>
            </tr>
        }
    </tbody>
</table>

