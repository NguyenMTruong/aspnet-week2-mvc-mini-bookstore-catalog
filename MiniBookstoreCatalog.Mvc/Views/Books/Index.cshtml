@model List<BookListItemViewModel>

@{
    ViewData["Title"] = "Book Catalog";
    var totalBooks = Model.Count;
}

<div class="page-header">
    <div>
        <h2 class="page-title">Book Catalog</h2>

        <p class="page-description">
            Đây là trang danh sách sách của cửa hàng.
        </p>
    </div>

    <div>
        <a class="btn btn-primary" href="/Books/Stats">
            Xem thống kê kho sách
        </a>
    </div>
</div>

<div class="info-panel">
    <strong>Tổng số sách:</strong> @totalBooks
</div>

@if (Model.Count == 0)
{
    <p>Chưa có sách nào trong hệ thống.</p>
}
else
{
    <table class="table table-bordered table-striped align-middle">
        <thead>
            <tr>
                <th>Mã sách</th>
                <th>Tên sách</th>
                <th>Thể loại</th>
                <th>Giá bán</th>
                <th>Số lượng</th>
                <th>Giá trị tồn kho</th>
                <th>Trạng thái</th>
                <th>Chi tiết</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Code</td>
                    <td>@item.Title</td>
                    <td>@item.Category</td>
                    <td>@item.PriceText</td>
                    <td>@item.Quantity</td>
                    <td>@item.InventoryValueText</td>

                    <td>
                        <span class="badge bg-primary">
                            @item.StockStatus
                        </span>
                    </td>

                    <td>
                        <a href="/Books/Detail/@item.Id">
                            Xem
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<p class="mt-4">
    <a class="btn btn-light" href="/">
        Quay lại trang chủ
    </a>
</p>
