@model List<MiniBookstoreCatalog.Mvc.ViewModels.BookListItemViewModel>

@{
    ViewData["Title"] = "Book Catalog";
}

<h2>Book Catalog</h2>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">
        Add New Book
    </a>

    <a asp-action="Trash" class="btn btn-secondary">
        Trash
    </a>

    <a asp-action="Stats" class="btn btn-success">
        Inventory Stats
    </a>
</div>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ISBN</th>
            <th>Book Code</th>
            <th>Title</th>
            <th>Author</th>
            <th>Category</th>
            <th>Price</th>
            <th>Stock</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (BookListItemViewModel item in Model)
        {
            <tr>
                <td>@item.ISBN</td>
                <td>@item.BookCode</td>
                <td>@item.Title</td>
                <td>@item.Author</td>
                <td>@item.CategoryName</td>
                <td>@item.Price.ToString("N0") VNĐ</td>
                <td>@item.Stock</td>
                <td>
                    <a asp-action="Detail" asp-route-id="@item.Id">
                        Detail
                    </a>
                </td>
                <td>
                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Id" />
                        <button class="btn btn-danger btn-sm" onclick="return confirm('Delete this book?')">
                            Delete
                        </button>
                    </form>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                        Edit
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

