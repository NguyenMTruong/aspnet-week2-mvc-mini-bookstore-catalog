@model MiniBookstoreCatalog.Mvc.ViewModels.BookDetailViewModel

@{
    ViewData["Title"] = "Book Detail";
}

<h2>Book Detail</h2>

<table class="table table-bordered">

    <tr>
        <th>ISBN</th>
        <td>@Model.ISBN</td>
    </tr>

    <tr>
        <th>Title</th>
        <td>@Model.Title</td>
    </tr>

    <tr>
        <th>Author</th>
        <td>@Model.Author</td>
    </tr>

    <tr>
        <th>Category</th>
        <td>@Model.CategoryName</td>
    </tr>

    <tr>
        <th>Price</th>
        <td>@Model.Price.ToString("N0") VNĐ</td>
    </tr>

    <tr>
        <th>Stock</th>
        <td>@Model.Stock</td>
    </tr>

    <tr>
        <th>Last Updated</th>
        <td>@Model.LastUpdatedAt</td>
    </tr>

</table>

<a asp-action="Index"
   class="btn btn-secondary">
    Back
</a>

